---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  return stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const formattedDate = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(story.data.date);
---

<BaseLayout title={story.data.title} description={story.data.description}>
  <article class="story-page">
    <header class="story-header">
      <a class="back-link" href={`${import.meta.env.BASE_URL}historias/`}>Todas las historias</a>
      <div class="story-meta">
        <time datetime={story.data.date.toISOString()}>{formattedDate}</time>
        {story.data.tags.map((tag: string) => <span>{tag}</span>)}
      </div>
      <h1>{story.data.title}</h1>
      <p>{story.data.description}</p>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
