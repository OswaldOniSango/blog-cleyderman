---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const about = await getEntry('pages', 'sobre-mi');

if (!about) {
  throw new Error('No se encontró el contenido de la página Sobre mí.');
}

const { Content } = await render(about);
---

<BaseLayout title="Sobre mí" description={about.data.description}>
  <section class="about-page">
    <p class="eyebrow">{about.data.eyebrow}</p>
    <h1>{about.data.title}</h1>
    <div class="about-copy prose-about"><Content /></div>
  </section>
</BaseLayout>
