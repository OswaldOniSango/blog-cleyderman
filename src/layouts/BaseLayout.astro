---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Clayderman Ivan — Historias',
  description = 'Relatos y otras formas de volver a mirar.',
} = Astro.props;

const pageTitle = title === 'Clayderman Ivan — Historias' ? title : `${title} — Clayderman Ivan`;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11100f" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Ir al inicio">
        <span>Clayderman</span>
        <span>Ivan</span>
      </a>
      <nav aria-label="Navegación principal">
        <a href={`${base}historias/`}>Historias</a>
        <a href={`${base}sobre-mi/`}>Sobre mí</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Clayderman Ivan</p>
      <p>Historias para leer sin prisa.</p>
    </footer>
  </body>
</html>
